# STT - Groq-hosted Whisper (openai.STT in worker.py, pointed at Groq's OpenAI-compatible
# endpoint). Sign up free at console.groq.com, no billing required. Same multilingual
# Whisper model that covers Tamil, unlike Deepgram Nova-2/Nova-3.
GROQ_API_KEY=

# DEEPGRAM_API_KEY= # no longer used - Deepgram doesn't support Tamil at all (confirmed via their own docs)
# GOOGLE_APPLICATION_CREDENTIALS= # no longer used for STT - hit a persistent IAM permission error
# OPENAI_API_KEY above no longer used for STT either - Whisper via OpenAI directly was
# tried, but the account's $0 free-trial credit + non-functioning payment blocked every call.

# TTS - ElevenLabs Flash v2.5, new: plain API key, no service account
ELEVENLABS_API_KEY=

# CARTESIA_API_KEY= # no longer used - ElevenLabs TTS replaced Cartesia

# Optional - defaults to gemini-2.5-flash if unset
LIVEKIT_LLM_MODEL=gemini-2.5-flash
